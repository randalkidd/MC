# Local settings for the Python tools in tools/ (copy to .env; .env is git-ignored).
# Nothing here is used by the website itself — the site is public static files, so a secret
# placed in any file the browser loads would be visible to everyone.

# County GIS subdivision layer used by tools/refresh_subdivisions.py (optional override)
SUBDIV_URL=https://gis.maricopa.gov/arcgis/rest/services/IndividualService/Parcel/MapServer/0
